{
  "mcpServers": {
    "probe": {
      "type": "stdio",
      "command": "@UV@",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "mcp>=2.3,<3",
        "python",
        "@KIT@/probe_mcp_server.py"
      ],
      "env": {
        "CHR_SPIKE_OUT": "/tmp/chr-gate-spike/claude",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
